# Copy this file to .env and fill in values. Never commit .env or any .env.* file.
# NEXT_PUBLIC_* values are baked into the static build and visible to every visitor.
# Do NOT put secrets here (no API keys, storage secrets, or tokens).

# Canonical public portfolio URL (used for canonical URL, Open Graph, sitemap, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://example.com

# Primary contact email address
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# Base URL for static assets (cloud storage, CDN). The resume button and assets stay hidden while empty.
NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.example.com

# URL to the live CPAA project. The live project button stays hidden while empty.
NEXT_PUBLIC_CPAA_URL=https://cpaa.example.com
